# LostKorea 리버스 프록시 + 자동 HTTPS(Let's Encrypt). 도메인은 .env 의 DOMAIN.
# 도메인 요청 → https 자동발급 + 백엔드 프록시. http는 https로 리다이렉트.
# 요청 본문 상한 10MB(사진 업로드도 화면에서 1600px로 줄여 보냄) — 대용량 요청으로 메모리를 잡아먹지 않게.
(site) {
	request_body {
		max_size 10MB
	}
	# 응답 압축(화면 HTML ~50KB → ~12KB). 대상을 명시해 실시간 진행 스트림(text/event-stream)은 제외 —
	# 기본 대상(text/*)에 포함되면 압축 버퍼 때문에 단계별 진행이 한꺼번에 늦게 도착할 수 있다.
	encode zstd gzip {
		match {
			header Content-Type text/html*
			header Content-Type text/plain*
			header Content-Type text/css*
			header Content-Type application/json*
			header Content-Type application/javascript*
			header Content-Type text/javascript*
			header Content-Type application/xml*
			header Content-Type application/manifest+json*
			header Content-Type image/svg+xml*
		}
	}
	# 보안 헤더 — 다른 사이트가 iframe으로 감싸기(클릭재킹)·MIME 추측·리퍼러 유출 방지, 서버 정보 숨김.
	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(), microphone=(), camera=()"
		-Server
	}
	reverse_proxy backend:8000
}

{$DOMAIN} {
	import site
	header Strict-Transport-Security "max-age=31536000"
}

# 도메인 없이 IP(http)로 와도 접속되게 (기존 http://IP 링크 유지). https 없음.
:80 {
	import site
}
